extends SceneTree
const Mapping := preload("res://ride_mapping.gd")
var failures := 0
func check(ok: bool, message: String) -> void:
	if not ok:
		failures += 1
		push_error(message)

func _initialize() -> void:
	var model := Mapping.new()
	var path := "user://test_mapping.json"
	check(model.validate(model.profiles).is_empty(), "Defaults validate")
	check(model.action_for("race", "Y") == "rider_info", "Y shows rider info")
	check(model.action_for("race", "B") == "look_back", "B holds rear view")
	check(model.action_for("menu", "B") == "back", "B goes back in menu")
	check(model.action_for("arcade", "DROP_LEFT").is_empty(), "Arcade drop is free")
	check(model.assign("race", "look_back", "Y", "hold").contains("Conflict"), "Collision rejected")
	check(model.action_for("race", "B") == "look_back", "Conflict leaves current profile unchanged")
	check(not model.assign("race", "look_back", "A", "press").is_empty(), "Hold cannot become a toggle")
	check(not model.assign("race", "pause", "A", "hold").is_empty(), "Discrete actions reject hold")
	check(not model.assign("race", "pause", "UNKNOWN", "press").is_empty(), "Unknown physical input rejected")
	check(model.assign("race", "look_back", "DROP_LEFT", "hold").is_empty(), "Physical alias normalized")
	check(model.assign("menu", "back", "Y", "release").is_empty(), "Menu supports release independently")
	check(model.save(path) == OK, "Mapping saved")
	check(model.save(path) == OK, "Existing mapping replaced atomically")
	var loaded := Mapping.new()
	loaded.load_settings(path)
	check(loaded.profiles == model.profiles and loaded.customized, "New instance restores profiles")
	loaded.reset("race")
	check(loaded.action_for("race", "B") == "look_back" and loaded.action_for("menu", "Y") == "back", "Per-context reset preserves other context")
	loaded.reset()
	check(loaded.profiles == Mapping.defaults(), "Reset all restores defaults")
	var file := FileAccess.open(path, FileAccess.WRITE)
	file.store_string('{"version":999,"profiles":{}}')
	file.close()
	loaded.load_settings(path)
	check(loaded.profiles == Mapping.defaults() and not loaded.status.is_empty(), "Unsupported version safely falls back")
	check(FileAccess.get_file_as_string(path).contains("999"), "Invalid user file is preserved")
	file = FileAccess.open(path, FileAccess.WRITE)
	file.store_string("not json")
	file.close()
	loaded.load_settings(path)
	check(loaded.profiles == Mapping.defaults(), "Malformed JSON safely falls back")
	var legacy := "user://legacy_mapping.json"
	file = FileAccess.open(legacy, FileAccess.WRITE)
	file.store_string(JSON.stringify({"A":"B", "B":"A", "SHIFT_UP_LEFT":"LEFT"}))
	file.close()
	loaded.load_settings("user://does_not_exist.json", legacy)
	check(loaded.action_for("menu", "A") == "back" and loaded.action_for("menu", "B") == "accept", "Legacy custom mapping migrates")
	check(loaded.action_for("menu", "Z") == "settings", "Phase 1 missing Z retains pause")
	check(loaded.action_for("menu", "SHIFT_UP_LEFT").is_empty(), "Legacy shift alias remains gearing")
	check(loaded.save("user://missing_directory/mapping.json") != OK, "Save failure reported")
	DirAccess.remove_absolute(path)
	DirAccess.remove_absolute(legacy)
	print("RIDE_MAPPING_OK failures=%d" % failures)
	quit(0 if failures == 0 else 1)
