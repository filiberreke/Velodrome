extends SceneTree
const Manager := preload("res://omnium/omnium_manager.gd")
const Score := preload("res://omnium/omnium_scoring.gd")
const Formats := preload("res://omnium/omnium_formats.gd")
func _initialize() -> void:
	assert(Score.place_points(1) == 40)
	assert(Score.place_points(20) == 2)
	assert(Score.place_points(21) == 1)
	assert(Score.place_points(24) == 1)
	assert(Formats.settings("women").points == 80)
	assert(Formats.race_laps("short", "scratch", 24) == 20)
	assert(Formats.race_laps("men", "scratch", 24) == 40)
	assert(Formats.race_laps("short", "points", 24) == 40)
	assert(Formats.race_laps("women", "points", 24) == 80)
	assert(Formats.race_laps("men", "points", 24) == 100)
	assert(Formats.race_laps("short", "elimination", 24) == 24)
	assert(Formats.race_laps("men", "elimination", 24) == 46)
	assert(Formats.race_laps("women", "elimination", 12) == 22)
	var manager = Manager.new()
	manager.store.folder = "user://omnium_test_" + str(Time.get_ticks_usec())
	var riders: Array = []
	for i in range(24): riders.append({"id":str(i), "country":str(i), "is_player":i == 0})
	var now := 1000000
	assert(manager.create(riders, "short", 80, now))
	assert(not manager.create(riders, "men", 80, now))
	var attempt: Dictionary = manager.begin_attempt(now)
	assert(attempt.discipline == "scratch")
	assert(manager.deadline() == now + 28 * 86400)
	assert(manager.abort_attempt())
	assert(manager.state.active.results.is_empty())
	attempt = manager.begin_attempt(now + 10)
	var order: Array = []
	for rider in riders: order.append(rider.id)
	assert(manager.finish_attempt(attempt.id, {"discipline":"scratch", "order":order}, {"1":{"reserve":0.5,"timestamp":now+20}}, now+20))
	assert(not manager.finish_attempt(attempt.id, {"discipline":"scratch", "order":order}, {}, now+20))
	assert(absf(manager.recovered_energy(now+3620)["1"] - 0.9) < 0.00001)
	assert(manager.deadline() == now+20+14*86400)
	assert(manager.check_deadline(now+21+14*86400))
	assert(manager.state.active.is_empty())
	assert(manager.state.archive.size() == 1)
	assert(manager.check_deadline(now+22+14*86400))
	assert(manager.state.archive.size() == 1)
	for suffix in ["state.json", "state.json.bak"]:
		DirAccess.remove_absolute(ProjectSettings.globalize_path(manager.store.folder.path_join(suffix)))
	DirAccess.remove_absolute(ProjectSettings.globalize_path(manager.store.folder))
	print("PASS omnium core")
	quit()
