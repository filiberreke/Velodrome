extends SceneTree
class Game extends "res://main.gd":
	func _bind_bridge(_port: int = UDP_PORT) -> Error: return super._bind_bridge(0)
var failures := 0
func check(ok: bool, message: String) -> void:
	if not ok: failures += 1; push_error(message)
func _initialize() -> void: call_deferred("run")
func run() -> void:
	var jury = preload("res://points_race_rules.gd").new()
	var notices = preload("res://points_notifications.gd").new()
	jury.reset(4, 40)
	check(notices.collect(jury, 2249).is_empty(), "No early warning")
	check(notices.collect(jury, 2250) == ["Tussensprint over 1 ronde!"], "One-lap warning")
	check(notices.collect(jury, 2300).is_empty(), "Warning must not repeat")
	jury.events.append({"rider": 1, "delta": 1})
	jury.events.append({"rider": 0, "delta": 1})
	jury.sprints.append({"lap": 10, "order": [1,0], "awards": [5,3]})
	check(notices.collect(jury, 2500) == ["+ 20 punten!", "+ 3 punten"], "Only player events; separate simultaneous awards")
	jury.events.append({"rider": 0, "delta": -1})
	check(notices.collect(jury, 2501) == ["- 20 punten"], "Lost lap")
	check(notices.collect(jury, 9750) == ["Eindsprint over 1 ronde!"], "Final warning")
	jury.sprints.append({"lap": 40, "order": [0], "awards": [10]})
	check(notices.collect(jury, 10000) == ["+ 10 punten"], "Double final sprint award")
	check(notices.collect(jury, 10001).is_empty(), "No repeated award")
	var popup = preload("res://race_popup.gd").new()
	root.add_child(popup)
	popup.set_process(false)
	popup.enqueue("+ 20 punten!")
	popup.enqueue("+ 3 punten")
	popup._process(2.6)
	check(popup.modulate.a < 1 and popup.modulate.a > 0 and popup.position.x > 100, "Fade and drift")
	popup._process(.4)
	check(popup.visible and popup.text == "+ 3 punten", "Queued message gets its own lifetime")
	popup._process(3)
	check(not popup.visible, "Popup disappears at three seconds")
	popup.free()
	var game = Game.new()
	root.add_child(game)
	game.set_physics_process(false)
	await process_frame
	game.setup_panel.select_mode(3)
	game._confirm_start()
	game.broadcast_intro.finish()
	game.broadcast_intro.cancel()
	game.start_state = "RACING"
	game.points_rules.points[1] = 100
	game.distances[2] = 50
	game._update_hud()
	check(game.minimap.leader_id == 2, "L follows position, not points")
	check(not game.race_overlay.status_panel.visible, "No persistent points banner")
	game.distances[0] = 60
	game._update_hud()
	check(game.minimap.leader_id == 0, "Player can take L")
	game.race_overlay.popup.enqueue("+ 5 punten")
	game._reset()
	check(not game.race_overlay.popup.visible and game.race_overlay.popup.pending.is_empty(), "Reset clears messages")
	game.free()
	print("POINTS_NOTIFICATIONS_OK" if failures == 0 else "POINTS_NOTIFICATIONS_FAILED")
	quit(0 if failures == 0 else 1)
